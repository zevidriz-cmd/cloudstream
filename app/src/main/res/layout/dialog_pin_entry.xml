<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryBlackBackground"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/pin_avatar_card"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@color/transparent"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="#1AFFFFFF"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/pin_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            tools:src="@drawable/avatar_1" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/pin_profile_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:text="Guest Profile" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Profile Lock is on."
        android:textColor="@color/white"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Enter your PIN to access this profile."
        android:textColor="#c2c6d6"
        android:textSize="16sp" />

    <!-- PIN Dot Indicators -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/pin_dot_1"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginHorizontal="12dp"
            android:src="@drawable/pin_dot_empty" />

        <ImageView
            android:id="@+id/pin_dot_2"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginHorizontal="12dp"
            android:src="@drawable/pin_dot_empty" />

        <ImageView
            android:id="@+id/pin_dot_3"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginHorizontal="12dp"
            android:src="@drawable/pin_dot_empty" />

        <ImageView
            android:id="@+id/pin_dot_4"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginHorizontal="12dp"
            android:src="@drawable/pin_dot_empty" />

    </LinearLayout>

    <!-- Error Text -->
    <TextView
        android:id="@+id/pin_error_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Incorrect PIN."
        android:textColor="#ffb4ab"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="invisible" />

    <!-- Numeric Keypad Grid -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/key_1"
                style="@style/PinKeyStyle"
                android:nextFocusRight="@id/key_2"
                android:nextFocusDown="@id/key_4"
                android:text="1" />
            <TextView
                android:id="@+id/key_2"
                style="@style/PinKeyStyle"
                android:nextFocusLeft="@id/key_1"
                android:nextFocusRight="@id/key_3"
                android:nextFocusDown="@id/key_5"
                android:text="2" />
            <TextView
                android:id="@+id/key_3"
                style="@style/PinKeyStyle"
                android:nextFocusLeft="@id/key_2"
                android:nextFocusDown="@id/key_6"
                android:text="3" />
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/key_4"
                style="@style/PinKeyStyle"
                android:nextFocusLeft="@id/key_4"
                android:nextFocusRight="@id/key_5"
                android:nextFocusUp="@id/key_1"
                android:nextFocusDown="@id/key_7"
                android:text="4" />
            <TextView
                android:id="@+id/key_5"
                style="@style/PinKeyStyle"
                android:nextFocusLeft="@id/key_4"
                android:nextFocusRight="@id/key_6"
                android:nextFocusUp="@id/key_2"
                android:nextFocusDown="@id/key_8"
                android:text="5" />
            <TextView
                android:id="@+id/key_6"
                style="@style/PinKeyStyle"
                android:nextFocusLeft="@id/key_5"
                android:nextFocusRight="@id/key_6"
                android:nextFocusUp="@id/key_3"
                android:nextFocusDown="@id/key_9"
                android:text="6" />
        </LinearLayout>

        <!-- Row 3 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/key_7"
                style="@style/PinKeyStyle"
                android:nextFocusLeft="@id/key_7"
                android:nextFocusRight="@id/key_8"
                android:nextFocusUp="@id/key_4"
                android:nextFocusDown="@id/key_0"
                android:text="7" />
            <TextView
                android:id="@+id/key_8"
                style="@style/PinKeyStyle"
                android:nextFocusLeft="@id/key_7"
                android:nextFocusRight="@id/key_9"
                android:nextFocusUp="@id/key_5"
                android:nextFocusDown="@id/key_0"
                android:text="8" />
            <TextView
                android:id="@+id/key_9"
                style="@style/PinKeyStyle"
                android:nextFocusLeft="@id/key_8"
                android:nextFocusRight="@id/key_9"
                android:nextFocusUp="@id/key_6"
                android:nextFocusDown="@id/key_backspace"
                android:text="9" />
        </LinearLayout>

        <!-- Row 4 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/key_cancel"
                style="@style/PinKeyStyle"
                android:enabled="true"
                android:focusable="true"
                android:nextFocusLeft="@id/key_cancel"
                android:nextFocusRight="@id/key_0"
                android:nextFocusUp="@id/key_7"
                android:nextFocusDown="@id/key_cancel"
                android:text="CANCEL"
                android:textColor="#c2c6d6"
                android:textSize="14sp"
                android:textStyle="normal" />
            <TextView
                android:id="@+id/key_0"
                style="@style/PinKeyStyle"
                android:nextFocusLeft="@id/key_0"
                android:nextFocusRight="@id/key_backspace"
                android:nextFocusUp="@id/key_8"
                android:nextFocusDown="@id/key_0"
                android:text="0" />
            <FrameLayout
                android:id="@+id/key_backspace"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_margin="6dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_pin_key_selector"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusLeft="@id/key_0"
                android:nextFocusRight="@id/key_backspace"
                android:nextFocusUp="@id/key_9"
                android:nextFocusDown="@id/key_backspace">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_backspace"
                    app:tint="@color/white" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>

